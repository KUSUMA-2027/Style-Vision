# ============================================================
# StyleVision Frontend — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit the .env file.
# Variables prefixed with EXPO_PUBLIC_ are exposed to the app.
# ============================================================

# --- Backend API URL ---
# Change this to your computer's local network IP (not localhost)
# when testing on a physical device via Expo Go.
# Example for physical device: http://192.168.1.100:8000
# Example for web/simulator:   http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# --- App environment ---
EXPO_PUBLIC_APP_ENV=development
