# ============================================================
# StyleVision Backend — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit the .env file.
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=StyleVision
DEBUG=true

# --- MongoDB ---
# Local development:
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=stylevision

# --- Authentication (JWT) ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
# Token expiry in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File storage ---
UPLOAD_DIR=uploads
CATALOGUE_DIR=catalogue
# Maximum upload size in bytes (default: 10 MB)
MAX_UPLOAD_SIZE=10485760
# Allowed image extensions (comma-separated)
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# --- CORS ---
# Comma-separated list of allowed origins
# Add your Expo dev client URL or local network IP
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# --- AI / Model ---
# Set to "prototype" (no GPU needed) or "catvton" (GPU required)
TRYON_MODE=prototype
# If using CatVTON GPU environment (e.g., Colab):
# CATVTON_ENDPOINT=https://your-colab-ngrok-url.ngrok.io
