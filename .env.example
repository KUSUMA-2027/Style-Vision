# StyleVision Backend Environment Configuration
APP_ENV=development
APP_NAME=StyleVision
DEBUG=true

# MongoDB (Automatically falls back to embedded zero-setup engine if local daemon is inactive)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=stylevision

# Authentication (JWT)
JWT_SECRET_KEY=stylevision_super_secret_jwt_key_2026_dev_env_secured_token_88
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# File Storage
UPLOAD_DIR=uploads
CATALOGUE_DIR=catalogue
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# CORS
CORS_ORIGINS=*

# AI Inference Mode: "replicate" (Serverless SOTA VTON, 0 GPU) | "catvton" (Kaggle/Colab) | "prototype" (CPU)
TRYON_MODE=replicate
REPLICATE_API_TOKEN=r8_K91ef32JzIsFADWodWB9cV5gJaSFShl0Dy3H1
CATVTON_ENDPOINT=
CUTOUT_API_KEY=